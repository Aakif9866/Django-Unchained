# Copy to .env for local development. Never commit the real .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, scheme included. Needed behind HTTPS proxies in production.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Empty = SQLite. Production example: postgres://user:pass@host:5432/sidequest
DATABASE_URL=
